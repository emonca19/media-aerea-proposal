// app/pilot/new-activity-screen.tsx
// ... (other imports)

export default function NewActivityScreen() {
  // ... (existing state and hooks)
  const [dateForLater, setDateForLater] = useState(new Date());
  const [showDateTimePicker, setShowDateTimePicker] = useState(false);
  const [dateTimePickerMode, setDateTimePickerMode] = useState<'date' | 'time'>('date');

  // ... (useEffect hooks)

  // --- DateTimePicker Handlers ---
  const onChangeTime = (event, selectedDate) => {
    console.log('onChangeTime event type:', event.type); // Good for debugging
    // For iOS, the picker might stay visible if it's a spinner or if 'default' isn't dismissed properly
    // For Android, it dismisses itself after 'set' or 'dismissed'
    if (Platform.OS === 'android') {
        setShowDateTimePicker(false); // Always hide on Android after an event
    }

    if (event.type === 'set' && selectedDate) {
      setDateForLater(selectedDate);
      // If on Android and date was just set, automatically show time picker
      if (Platform.OS === 'android' && dateTimePickerMode === 'date') {
        setDateTimePickerMode('time');
        setShowDateTimePicker(true); // Re-show for time
      } else if (Platform.OS === 'ios' && dateTimePickerMode === 'date') {
        // On iOS, if using 'spinner', it just updates. If 'default', it should close.
        // If you want a two-step process on iOS with 'default' display, you'd handle it here.
        // For 'spinner', no need to re-show.
      }
    } else if (event.type === 'dismissed') {
      // User dismissed the picker (e.g., tapped outside on Android, or Cancel on iOS modal)
      setShowDateTimePicker(false);
    }
    // If platform is iOS and display is 'spinner', setShowDateTimePicker(false) would hide it.
    // If display is 'default' on iOS, it should close itself on selection/cancel.
    // If it's not closing, ensure you are not overriding this behavior.
  };

  const showMode = (modeToShow) => {
    console.log(`Showing ${modeToShow} picker. Current showDateTimePicker: ${showDateTimePicker}`);
    // If trying to show the same mode that's already theoretically shown by the picker,
    // it might be better to hide and re-show to ensure it's fresh, especially on Android.
    // However, for iOS spinner, this isn't necessary.
    
    // setShowDateTimePicker(false); // Optional: force hide before show
    // requestAnimationFrame(() => { // Ensure state update processes
        setDateTimePickerMode(modeToShow);
        setShowDateTimePicker(true);
    // });
  };

  // --- Submit Handler ---
  // ... (handleSubmit remains the same)

  // --- Render ---
  return (
    <View style={styles.screenContainer}>
      <Stack.Screen options={{ title: 'Registrar Actividad' }} />
      {/*
        Consider removing KeyboardAvoidingView temporarily if it's causing issues,
        or ensure its styling is not interfering.
        If you have a <KeyboardAvoidingView behavior="padding" style={{flex:1}}>
        wrapping the ScrollView, that's usually okay.
      */}
      <ScrollView
        style={styles.scrollView}
        contentContainerStyle={styles.scrollContentContainer}
        keyboardShouldPersistTaps="handled" // "handled" is usually good. Try "always" if desperate.
        showsVerticalScrollIndicator={false}
      >
        {/* ... (other form elements: currentTime, typeSelection, assetSelection, notes, switch) ... */}
        <Text style={styles.currentTime}>{currentTimeString}</Text>

        <Text style={styles.subtitle}>Tipo de Actividad</Text>
        <View style={styles.typeSelection}>
            {quickActivityTypes.map((type) => (
            <TouchableOpacity
                key={type.id}
                style={[styles.typeCard, activityTypeId === type.id && styles.typeCardSelected]}
                onPress={() => setActivityTypeId(type.id)} // Simplified for brevity
            >
                <MaterialCommunityIcons name={type.icon} size={24} color={activityTypeId === type.id ? '#fff' : '#3b82f6'} />
                <Text style={[styles.typeLabel, activityTypeId === type.id && styles.typeLabelSelected]}>{type.label}</Text>
            </TouchableOpacity>
            ))}
        </View>

        {requiresAssetSelection && (
            <View style={styles.assetSelection}>
                <Text style={styles.subtitle}>Selecciona Equipo/Turbina/Sitio</Text>
                <ScrollView horizontal showsHorizontalScrollIndicator={false} contentContainerStyle={styles.assetScroll}>
                    {availableAssets.map(asset => (
                    <TouchableOpacity
                        key={asset.id}
                        style={[styles.assetCard, selectedAssetId === asset.id && styles.assetCardSelected]}
                        onPress={() => setSelectedAssetId(asset.id)}
                    >
                        <Ionicons name="cog-outline" size={24} color={selectedAssetId === asset.id ? '#fff' : '#f59e0b'} />
                        <Text style={[styles.assetName, selectedAssetId === asset.id && styles.assetNameSelected]}>{asset.name}</Text>
                        <Text style={[styles.assetStatus, selectedAssetId === asset.id && styles.assetStatusSelected]}>{asset.status.replace('_', ' ').toUpperCase()}</Text>
                    </TouchableOpacity>
                    ))}
                </ScrollView>
            </View>
        )}

        {activityTypeId === 'ACT_OTRO' && (
             <>
              <Text style={styles.subtitle}>Nombre Actividad Personalizada</Text>
              <TextInput
                  style={styles.notesInput}
                  placeholder="Ej: Calibración de GPS"
                  value={customActivityNameInput}
                  onChangeText={setCustomActivityNameInput}
                  placeholderTextColor="#94a3b8"
              />
            </>
        )}

        <Text style={styles.subtitle}>Notas Adicionales (Opcional)</Text>
        <TextInput
            style={styles.notesInput}
            placeholder="Detalles relevantes sobre la actividad..."
            value={activityNotes}
            onChangeText={setActivityNotes}
            multiline={true}
            numberOfLines={3}
            placeholderTextColor="#94a3b8"
        />

        <View style={globalFormStyles.form_switchContainer}>
            <Text style={styles.subtitle}>¿Iniciar ahora?</Text>
            <Switch /* ...props... */ 
                trackColor={{ false: "#d1d5db", true: "#818cf8" }}
                thumbColor={isForNow ? "#4f46e5" : "#f1f5f9"}
                ios_backgroundColor="#e5e7eb"
                onValueChange={setIsForNow}
                value={isForNow}
            />
        </View>


        {!isForNow && (
            <View style={styles.datePickerContainer}>
                <Text style={styles.subtitle}>Programar para:</Text>
                <View style={styles.dateDisplayRow}>
                    <TouchableOpacity 
                        onPress={() => {
                            console.log('Fecha button pressed');
                            showMode('date');
                        }} 
                        style={styles.datePickerButton}
                    >
                        <Ionicons name="calendar-outline" size={20} color="#3b82f6" />
                        <Text style={styles.datePickerButtonText}>Fecha: {dateForLater.toLocaleDateString('es-ES')}</Text>
                    </TouchableOpacity>
                    <TouchableOpacity 
                        onPress={() => {
                            console.log('Hora button pressed');
                            showMode('time');
                        }} 
                        style={styles.datePickerButton}
                    >
                        <Ionicons name="time-outline" size={20} color="#3b82f6" />
                        <Text style={styles.datePickerButtonText}>Hora: {dateForLater.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</Text>
                    </TouchableOpacity>
                </View>
                {/* Conditionally render the DateTimePicker */}
                {showDateTimePicker && (
                    <DateTimePicker
                        testID="dateTimePicker"
                        value={dateForLater}
                        mode={dateTimePickerMode}
                        is24Hour={true}
                        display={Platform.OS === 'ios' ? 'spinner' : 'default'}
                        onChange={onChangeTime}
                        minimumDate={new Date()}
                        // For iOS with 'spinner', you might want to wrap this in a View with fixed height
                        // or ensure its container has enough space.
                        // style={Platform.OS === 'ios' ? { height: 200, width: '100%' } : {}} // Example for iOS spinner
                    />
                )}
            </View>
        )}

        {/* ... (Submit Button) ... */}
        <TouchableOpacity style={styles.actionButton} onPress={handleSubmit}>
            <Text style={styles.actionButtonText}>
                {isForNow
                    ? (requiresAssetSelection && selectedAssetId && availableAssets.find(t => t.id === selectedAssetId)
                        ? `Iniciar en ${availableAssets.find(t => t.id === selectedAssetId)?.name}`
                        : 'Iniciar Actividad')
                    : 'Programar Actividad'
                }
            </Text>
        </TouchableOpacity>
      </ScrollView>
    </View>
  );
}

