import { Ionicons } from '@expo/vector-icons';
import { LinearGradient } from 'expo-linear-gradient';
import { useRouter } from 'expo-router';
import React from 'react';
import { Image, ScrollView, StyleSheet, Text, TouchableOpacity, View } from 'react-native';
import { pilot } from './components/pilot-dashboard-data';

import PilotStatistics from './statistics';

export default function PilotProfile() {
  const router = useRouter();

  const handleLogout = async () => {
    router.replace('/login');
  };

  return (
    <ScrollView style={styles.container} showsVerticalScrollIndicator={false}>
      {/* Header con efecto de gradiente mejorado */}
      <LinearGradient
        colors={['#4338ca', '#3b82f6']}
        start={{ x: 0, y: 0 }}
        end={{ x: 1, y: 1 }}
        style={styles.header}
      >
        <View style={styles.headerContent}>
          {/* Información del perfil */}
          <View style={styles.avatarContainer}>
            <Image source={pilot.avatar} style={styles.avatar} />
            <View style={styles.statusIndicator}>
              <View style={styles.statusDot} />
            </View>
          </View>
          
          <View style={styles.profileInfo}>
            <Text style={styles.name}>{pilot.name}</Text>
            <Text style={styles.role}>{pilot.role}</Text>
          </View>

          {/* Insignia de licencia */}
          <View style={styles.licenseContainer}>
            <Ionicons name="shield-checkmark" size={16} color="#fff" style={styles.licenseIcon} />
            <Text style={styles.licenseText}>{pilot.licenseNumber}</Text>
          </View>
        </View>
      </LinearGradient>

      {/* Panel de accesos rápidos */}
      <View style={styles.quickAccessContainer}>
        <TouchableOpacity 
          style={styles.quickAccessButton} 
          onPress={() => router.push('/pilot/project-history')}
          activeOpacity={0.7}
        >
          <View style={styles.quickAccessIconContainer}>
            <Ionicons name="briefcase-outline" size={22} color="#4338ca" />
          </View>
          <Text style={styles.quickAccessText}>Proyectos</Text>
        </TouchableOpacity>

        <TouchableOpacity 
          style={styles.quickAccessButton} 
          onPress={() => router.push('/pilot/calendar')}
          activeOpacity={0.7}
        >
          <View style={styles.quickAccessIconContainer}>
            <Ionicons name="calendar-outline" size={22} color="#4338ca" />
          </View>
          <Text style={styles.quickAccessText}>Calendario</Text>
        </TouchableOpacity>

        <TouchableOpacity 
          style={styles.quickAccessButton} 
          onPress={() => router.push('/pilot/support-chat')}
          activeOpacity={0.7}
        >
          <View style={styles.quickAccessIconContainer}>
            <Ionicons name="headset-outline" size={22} color="#4338ca" />
          </View>
          <Text style={styles.quickAccessText}>Soporte</Text>
        </TouchableOpacity>
      </View>

      {/* Sección de resumen personal */}
      <View style={styles.summaryContainer}>
        <View style={styles.summaryCard}>
          <View style={styles.summaryIconContainer}>
            <Ionicons name="trending-up" size={20} color="#4338ca" />
          </View>
          <View>
            <Text style={styles.summaryLabel}>Rendimiento</Text>
            <Text style={styles.summaryValue}>+12%</Text>
          </View>
        </View>

        <View style={styles.summaryCard}>
          <View style={styles.summaryIconContainer}>
            <Ionicons name="star" size={20} color="#4338ca" />
          </View>
          <View>
            <Text style={styles.summaryLabel}>Eficiencia</Text>
            <Text style={styles.summaryValue}>4.8/5</Text>
          </View>
        </View>
      </View>

      {/* Sección de estadísticas personales */}
      <View style={styles.statisticsContainer}>
        <View style={styles.sectionHeader}>
          <Text style={styles.sectionTitle}>Estadísticas</Text>
          <TouchableOpacity>
            <Text style={styles.seeAllText}>Ver todos</Text>
          </TouchableOpacity>
        </View>
        <PilotStatistics />
      </View>

      {/* Sección de accesos principales */}      
      <View style={styles.mainActionsContainer}>
        <View style={styles.sectionHeader}>
          <Text style={styles.sectionTitle}>Acciones rápidas</Text>
        </View>
        
        {/* Botón de historial de proyectos */}        
        <TouchableOpacity 
          style={styles.mainActionButton} 
          onPress={() => router.push('/pilot/project-history')}
          activeOpacity={0.85}
        >
          <LinearGradient
            colors={['#4f46e5', '#3730a3']}
            start={{ x: 0, y: 0 }}
            end={{ x: 1, y: 1 }}
            style={styles.mainActionGradient}
          >
            <Ionicons name="briefcase" size={20} color="#fff" style={styles.mainActionIcon} />
            <Text style={styles.mainActionText}>Mi historial de proyectos</Text>
            <Ionicons name="chevron-forward" size={18} color="#fff" style={styles.mainActionArrow} />
          </LinearGradient>
        </TouchableOpacity>

        {/* Botón de calendario */}
        <TouchableOpacity 
          style={styles.mainActionButton} 
          onPress={() => router.push('/pilot/calendar')}
          activeOpacity={0.85}
        >
          <LinearGradient
            colors={['#4f46e5', '#3730a3']}
            start={{ x: 0, y: 0 }}
            end={{ x: 1, y: 1 }}
            style={styles.mainActionGradient}
          >
            <Ionicons name="calendar" size={20} color="#fff" style={styles.mainActionIcon} />
            <Text style={styles.mainActionText}>Calendario</Text>
            <Ionicons name="chevron-forward" size={18} color="#fff" style={styles.mainActionArrow} />
          </LinearGradient>
        </TouchableOpacity>

        {/* Botón de soporte */}
        <TouchableOpacity 
          style={styles.mainActionButton} 
          onPress={() => router.push('/pilot/support-chat')}
          activeOpacity={0.85}
        >
          <LinearGradient
            colors={['#4f46e5', '#3730a3']}
            start={{ x: 0, y: 0 }}
            end={{ x: 1, y: 1 }}
            style={styles.mainActionGradient}
          >
            <Ionicons name="headset" size={20} color="#fff" style={styles.mainActionIcon} />
            <Text style={styles.mainActionText}>Soporte</Text>
            <Ionicons name="chevron-forward" size={18} color="#fff" style={styles.mainActionArrow} />
          </LinearGradient>
        </TouchableOpacity>
      </View>
      
      {/* Botón de cerrar sesión */}
      <TouchableOpacity 
        style={styles.logoutButton} 
        onPress={handleLogout}
        activeOpacity={0.85}
      >
        <LinearGradient
          colors={['#E85F5C', '#E33D3B']}
          start={{ x: 0, y: 0 }}
          end={{ x: 1, y: 1 }}
          style={styles.logoutGradient}
        >
          <View style={styles.logoutContent}>
            <Ionicons name="log-out-outline" size={22} color="#fff" style={{ marginRight: 10 }} />
            <Text style={styles.logoutButtonText}>Cerrar sesión</Text>
          </View>
        </LinearGradient>
      </TouchableOpacity>
      
      {/* Espaciado final */}
      <View style={{ height: 24 }} />
    </ScrollView>
  );
}

